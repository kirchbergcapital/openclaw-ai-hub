{
  "channels": {
    "telegram": {
      "botToken": "YOUR_TELEGRAM_BOT_TOKEN"
    }
  },
  "gateway": {
    "port": 18789
  },
  "models": {
    "primary": "anthropic/claude-sonnet-4-6"
  },
  "agents": {
    "defaults": {
      "heartbeat": {
        // Recommended: use shell LaunchAgent (com.openclaw.heartbeat.plist) + set target to "none"
        // LLM heartbeats with local models cause gateway hangs when the model is cold.
        "target": "none",
        // If you prefer LLM heartbeats, use mistral-small:22b (NOT qwen2.5:3b — timeout issues):
        // "model": "ollama/mistral-small:22b",
        // "lightContext": true,
        "interval": 3600,
        "schedule": "8-22"
      }
    }
  },
  "memory": {
    "sync": {
      // sync.watch is unreliable in production — new files are often not indexed automatically.
      // Use the com.openclaw.memory-index-sync LaunchAgent instead (runs hourly, forces re-index if dirty).
      "watch": false
    }
  }
}
