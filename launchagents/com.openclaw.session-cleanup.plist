<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.openclaw.session-cleanup</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>find "$HOME/.openclaw/agents/main/sessions" -name "*.jsonl" -mmin +120 -type f -delete 2>/dev/null; echo "$(date): session cleanup done" >> /tmp/openclaw-session-cleanup.log</string>
    </array>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/tmp/openclaw-session-cleanup-error.log</string>
</dict>
</plist>
